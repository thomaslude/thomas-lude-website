---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kontakt | Thomas Lude" description="Kontakt und Terminvereinbarung bei Thomas Lude.">
  <h1>Kontakt</h1>
  <p>[Platzhalter – kurzer Einleitungstext]</p>

  <!--
    Platzhalter-Formular. Funktioniert erst, wenn ein Versandweg angebunden ist:
    - Deploy auf Netlify → data-netlify="true" ergänzen (kostenlos, kein Backend nötig)
    - Deploy auf Cloudflare Pages → z. B. kostenlosen Dienst wie web3forms.com einbinden
    Bis dahin einfach den mailto-Link unten nutzen.
  -->
  <form class="contact-form" name="kontakt" method="POST">
    <label>
      Name
      <input type="text" name="name" required />
    </label>
    <label>
      E-Mail
      <input type="email" name="email" required />
    </label>
    <label>
      Nachricht
      <textarea name="nachricht" rows="5" required></textarea>
    </label>
    <button type="submit">Absenden</button>
  </form>

  <p>Oder direkt per E-Mail: <a href="mailto:kontakt@thomas-lude.de">kontakt@thomas-lude.de</a></p>
</BaseLayout>
